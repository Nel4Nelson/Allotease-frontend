 {Array.from({ length: 10 }).map((_, i) => (
            <CarouselItem
              key={i}
              className="basis-1/1 md:basis-1/3 lg:basis-1/3"
            >
              <div className="flex justify-center">
                <div className="flex flex-col items-center justify-between gap-4 bg-[#F2F4F7] w-[210px] h-[240px] rounded-[20px] p-4">
                  <div className="bg-[#FF5B00] border border-[#BC4300] h-[80px] w-[80px] rounded-full flex items-center justify-center p-[1px]">
                    <Image
                      src="/icons/star.svg"
                      height={40}
                      width={40}
                      alt="star icon"
                      className="object-contain"
                    />
